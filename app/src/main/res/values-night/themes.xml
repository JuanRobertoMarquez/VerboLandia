<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Mode) -->
    <style name="Theme.Verbolandia" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Accent Colors -->
        <item name="colorPrimary">@color/inverse_primary</item>
        <item name="colorOnPrimary">#003353</item>
        <item name="colorPrimaryContainer">#004B73</item>
        <item name="colorOnPrimaryContainer">@color/primary_fixed</item>

        <item name="colorSecondary">@color/secondary_fixed_dim</item>
        <item name="colorOnSecondary">#00354A</item>
        <item name="colorSecondaryContainer">#004D6A</item>
        <item name="colorOnSecondaryContainer">@color/secondary_fixed</item>

        <item name="colorTertiary">@color/tertiary_fixed_dim</item>
        <item name="colorOnTertiary">#262E43</item>
        <item name="colorTertiaryContainer">#3F465C</item>
        <item name="colorOnTertiaryContainer">@color/tertiary_fixed</item>

        <!-- Surfaces & Backgrounds -->
        <item name="colorSurface">#0B1C30</item>
        <item name="colorOnSurface">@color/inverse_on_surface</item>
        <item name="colorSurfaceVariant">#3F4850</item>
        <item name="colorOnSurfaceVariant">@color/outline_variant</item>
        <item name="android:colorBackground">#0B1C30</item>
        <item name="colorOnBackground">@color/inverse_on_surface</item>

        <!-- Outlines & Borders -->
        <item name="colorOutline">#89929B</item>
        <item name="colorOutlineVariant">#3F4850</item>

        <!-- Error Tones -->
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">@color/error_container</item>

        <!-- System Window / Status Bar Edge-to-Edge Configuration -->
        <item name="android:statusBarColor">#0B1C30</item>
        <item name="android:navigationBarColor">#0B1C30</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- Alias for compatibility with AndroidManifest.xml -->
    <style name="Theme.VerboLandia" parent="Theme.Verbolandia" />
    <style name="Base.Theme.VerboLandia" parent="Theme.Verbolandia" />
</resources>
