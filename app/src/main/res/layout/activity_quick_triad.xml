<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/layoutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutStreakBadge"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/triad_activity_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_label_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgressCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_body_sm"
                tools:text="Verbo 1 de 10" />
        </LinearLayout>

        <!-- Streak Badge with Vector Icon -->
        <LinearLayout
            android:id="@+id/layoutStreakBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_detail_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fire" />

            <TextView
                android:id="@+id/tvStreakCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/accent_gold"
                android:textSize="@dimen/text_label_md"
                android:textStyle="bold"
                tools:text="x0" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="10"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackThickness="4dp"
        tools:progress="3" />

    <!-- Full Screen Responsive Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameplayContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/margin"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <!-- Subheader Status Bar (Vector Timer + Adaptive Mode Tag) -->
        <LinearLayout
            android:id="@+id/layoutSubheader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvModeSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/triad_mode_subtitle_normal"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_detail_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_timer"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvTimerCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold"
                    tools:text="00:00" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero Verb Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeroVerb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/rounded_lg"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutSubheader"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/badgeLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_detail_badge"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="3dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="A1 • IRREGULAR" />

                <ImageButton
                    android:id="@+id/btnTtsAudio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_detail_badge"
                    android:contentDescription="@string/cd_play_audio"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volume"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvBaseVerb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnTtsAudio"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/badgeLevel"
                    tools:text="CHOOSE" />

                <TextView
                    android:id="@+id/tvBasePhonetic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body_sm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBaseVerb"
                    tools:text="/tʃuːz/ • V1 Infinitivo" />

                <TextView
                    android:id="@+id/tvSpanishMeaning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBasePhonetic"
                    tools:text="elegir, escoger" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Matriz de Ranuras (Slot Matrix) -->
        <TextView
            android:id="@+id/tvTriadMatrixTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/triad_matrix_title"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHeroVerb" />

        <LinearLayout
            android:id="@+id/layoutSlots"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/tvTriadMatrixTitle">

            <!-- Slot 1: V1 BASE (Completado) -->
            <LinearLayout
                android:id="@+id/slotV1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_triad_slot_completed"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/triad_v1_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlotV1Val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    tools:text="choose" />

                <TextView
                    android:id="@+id/tvSlotV1Ipa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="/tʃuːz/" />
            </LinearLayout>

            <!-- Slot 2: V2 PASADO (Objetivo 1) -->
            <LinearLayout
                android:id="@+id/slotV2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_triad_slot_active"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/triad_v2_label"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlotV2Val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="?"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlotV2Ipa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="--" />
            </LinearLayout>

            <!-- Slot 3: V3 PARTICIPIO (Objetivo 2) -->
            <LinearLayout
                android:id="@+id/slotV3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_triad_slot_normal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/triad_v3_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlotV3Val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="?"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlotV3Ipa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/triad_locked_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm" />
            </LinearLayout>
        </LinearLayout>

        <!-- Options Header Row -->
        <LinearLayout
            android:id="@+id/layoutOptionsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/layoutSlots">

            <TextView
                android:id="@+id/tvOptionsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/triad_options_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/triad_select_v2"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2x2 Answer Grid: FILLS ALL AVAILABLE VERTICAL SCREEN SPACE -->
        <LinearLayout
            android:id="@+id/layoutOptionsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:weightSum="2"
            app:layout_constraintBottom_toTopOf="@id/cardFeedback"
            app:layout_constraintTop_toBottomOf="@id/layoutOptionsHeader">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Option 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOpt1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/rounded_md"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:id="@+id/tvOpt1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="chose" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Option 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOpt2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/rounded_md"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:id="@+id/tvOpt2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="chosen" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Option 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOpt3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/rounded_md"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:id="@+id/tvOpt3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="choosed" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Option 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOpt4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/rounded_md"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:id="@+id/tvOpt4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="chosed" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Pedagogical Feedback Card (Displayed upon attempt completion) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:cardCornerRadius="@dimen/rounded_lg"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1.5dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Header Row: Icon + Title + Combo Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivFeedbackIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="@color/success" />

                    <TextView
                        android:id="@+id/tvFeedbackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/triad_correct_title"
                        android:textColor="@color/success"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFeedbackComboBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_detail_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold"
                        tools:text="COMBO x2" />
                </LinearLayout>

                <!-- Feedback Subtitle / Correct Answer Note -->
                <TextView
                    android:id="@+id/tvFeedbackSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="La respuesta correcta era: chose"
                    tools:visibility="visible" />

                <!-- Mnemonic Tip -->
                <TextView
                    android:id="@+id/tvFeedbackTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="Regla mnemotécnica: pierde una «o» en pasado (chose) y añade «n» en participio (chosen)." />

                <!-- Contextual Example with Vector Lightbulb Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvFeedbackExample"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body_sm"
                        android:textStyle="italic"
                        tools:text="Ejemplo: Yesterday, they chose the best option available." />
                </LinearLayout>

                <!-- Action Button: Next Verb -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextVerb"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/triad_next_button"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="@dimen/text_headline_sm"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="@dimen/rounded_lg"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconTint="?attr/colorOnPrimary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
