<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_dictionary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="@string/verb_detail_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_headline_sm"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/cd_avatar"
            android:src="@drawable/ic_avatar_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Metadata Row: Badges & Bookmark -->
            <TextView
                android:id="@+id/badgeIrregular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_pill_detail_badge"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="4dp"
                android:text="@string/badge_irregular"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_sm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/badgeHighFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_pill_detail_badge"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="4dp"
                android:text="@string/badge_high_freq"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_sm"
                app:layout_constraintBaseline_toBaselineOf="@id/badgeIrregular"
                app:layout_constraintStart_toEndOf="@id/badgeIrregular" />

            <TextView
                android:id="@+id/badgeLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_pill_detail_badge"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="4dp"
                android:text="@string/badge_level"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/badgeIrregular"
                app:layout_constraintStart_toEndOf="@id/badgeHighFreq" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_bookmark"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark"
                app:layout_constraintBottom_toBottomOf="@id/badgeIrregular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/badgeIrregular"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Lexical Header: Verb, Phonetic, Audio Button & Meaning -->
            <TextView
                android:id="@+id/tvVerbName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/detail_verb_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_display_lg"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badgeIrregular" />

            <TextView
                android:id="@+id/tvPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/detail_phonetic"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_body_lg"
                app:layout_constraintBaseline_toBaselineOf="@id/tvVerbName"
                app:layout_constraintStart_toEndOf="@id/tvVerbName" />

            <ImageButton
                android:id="@+id/btnPlayAudio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tense_tag_dark"
                android:contentDescription="@string/cd_play_audio"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume"
                app:layout_constraintBottom_toBottomOf="@id/tvVerbName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvVerbName"
                app:tint="?attr/colorOnPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/rounded_md"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvVerbName"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meaning_header"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/meaning_primary"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Block 1: Formas Gramaticales -->
            <TextView
                android:id="@+id/tvGrammaticalFormsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/grammatical_forms_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_md"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMeaning" />

            <TextView
                android:id="@+id/badgeGrammaticalMatrix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_detail_badge"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="2dp"
                android:text="@string/grammatical_matrix_badge"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                app:layout_constraintBaseline_toBaselineOf="@id/tvGrammaticalFormsTitle"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 3 Column Matrix (V1, V2, V3) -->
            <LinearLayout
                android:id="@+id/layoutGrammaticalMatrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGrammaticalFormsTitle">

                <!-- Column V1 BASE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_matrix_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/col_v1_title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sample_v1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sample_v1_phonetic"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm" />
                </LinearLayout>

                <!-- Column V2 SIMPLE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_matrix_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tense_tag_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="@string/tense_pasado"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sample_v2"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sample_v2_phonetic"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm" />
                </LinearLayout>

                <!-- Column V3 PARTICIPLE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_matrix_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tense_tag_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="@string/tense_participio"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sample_v3"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sample_v3_phonetic"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm" />
                </LinearLayout>
            </LinearLayout>

            <!-- Derived Tenses Row -->
            <LinearLayout
                android:id="@+id/layoutDerivedTenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutGrammaticalMatrix">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_detail_badge"
                    android:gravity="center"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:text="@string/derived_third_person"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body_sm" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_detail_badge"
                    android:gravity="center"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:text="@string/derived_gerund"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body_sm" />
            </LinearLayout>

            <!-- Block 2: Patrón Mnemotécnico -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMnemonic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/rounded_lg"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutDerivedTenses"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lightbulb"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/mnemonic_title"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_label_md"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/mnemonic_pattern"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold" />

                    <!-- Matrix Table of Verb Families -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_matrix_card"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mnemonic_family_1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_body_sm" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mnemonic_family_2"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_body_sm" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mnemonic_family_3"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_body_sm"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Block 3: Verbo en Acción (Ejemplos) -->
            <TextView
                android:id="@+id/tvExamplesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/examples_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_md"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMnemonic" />

            <TextView
                android:id="@+id/tvExamplesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/examples_count"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_sm"
                app:layout_constraintBaseline_toBaselineOf="@id/tvExamplesTitle"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Example Card 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEx1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="@dimen/rounded_md"
                app:cardElevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExamplesTitle"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvEx1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ex_1_title"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_play_audio"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_volume"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvEx1En"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ex_1_en"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tvEx1Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ex_1_es"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body_sm"
                        app:layout_constraintTop_toBottomOf="@id/tvEx1En" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Example Card 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEx2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="@dimen/rounded_md"
                app:cardElevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardEx1"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvEx2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ex_2_title"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_play_audio"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_volume"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvEx2En"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ex_2_en"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tvEx2Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ex_2_es"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body_sm"
                        app:layout_constraintTop_toBottomOf="@id/tvEx2En" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Example Card 3: Phrasal Verb -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEx3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="@dimen/rounded_md"
                app:cardElevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardEx2"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvEx3Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_detail_badge"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="2dp"
                        android:text="@string/ex_3_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvEx3BadgeRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ex_3_badge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvEx3Badge"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvEx3En"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ex_3_en"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tvEx3Badge" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ex_3_es"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body_sm"
                        app:layout_constraintTop_toBottomOf="@id/tvEx3En" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Block 4: Error Común a Evitar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardErrorWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="?attr/colorErrorContainer"
                app:cardCornerRadius="@dimen/rounded_lg"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardEx3"
                app:strokeColor="?attr/colorError"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_warning"
                            app:tint="?attr/colorError" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/error_warning_title"
                            android:textColor="?attr/colorError"
                            android:textSize="@dimen/text_label_md"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/error_warning_desc"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Block 5: Nivel de Retención -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRetention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/rounded_lg"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardErrorWarning"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvRetentionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/retention_title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_md"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvRetentionMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/retention_metric"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_headline_lg"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressRetention"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:indicatorColor="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvRetentionMetric"
                        app:trackColor="?attr/colorSurfaceContainerHighest"
                        app:trackCornerRadius="@dimen/rounded_full"
                        app:trackThickness="@dimen/progress_track_height"
                        tools:progress="82" />

                    <TextView
                        android:id="@+id/tvRetentionViews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/retention_views"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressRetention" />

                    <TextView
                        android:id="@+id/tvRetentionLastSuccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/retention_last_success"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_sm"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvRetentionViews"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_bottom_action_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="48dp"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_matrix_card"
            android:contentDescription="@string/cd_shuffle"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shuffle"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPractice"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/btn_practice_verb"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_headline_sm"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="@dimen/rounded_lg"
            app:icon="@drawable/ic_flash"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
