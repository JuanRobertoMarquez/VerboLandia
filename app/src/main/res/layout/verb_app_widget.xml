<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_action_bar"
    android:padding="12dp">

    <!-- Header Row -->
    <ImageView
        android:id="@+id/ivWidgetIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@null"
        android:src="@drawable/ic_dictionary" />

    <TextView
        android:id="@+id/tvWidgetHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/ivWidgetIcon"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@id/ivWidgetIcon"
        android:text="@string/widget_header"
        android:textColor="@color/secondary_accent"
        android:textSize="@dimen/text_label_sm"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnWidgetRefresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/widget_refresh_desc"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shuffle" />

    <!-- Verb Main Title -->
    <TextView
        android:id="@+id/tvWidgetVerbBase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWidgetHeader"
        android:layout_marginTop="4dp"
        android:text="@string/widget_default_base"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetMeaning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/tvWidgetVerbBase"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@id/tvWidgetVerbBase"
        android:text="@string/widget_default_meaning"
        android:textColor="@color/widget_text_slate"
        android:textSize="@dimen/text_body_sm" />

    <!-- Conjugations Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWidgetVerbBase"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetV1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_small"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="@string/widget_default_v1"
            android:textColor="@color/primary_accent"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetV2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_small"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="@string/widget_default_v2"
            android:textColor="@color/primary_accent"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetV3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_small"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="@string/widget_default_v3"
            android:textColor="@color/primary_accent"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
