<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_main_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- TOP HEADER ROW: App Logo + Title + Date Badge + Refresh Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/llWidgetHeaderRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWidgetDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_stat_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="MAR, 24 NOV" />

            <ImageButton
                android:id="@+id/btnWidgetRefresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_stat_pill"
                android:contentDescription="@string/widget_refresh_desc"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shuffle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llWidgetBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/llWidgetHeaderRight"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivWidgetIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:id="@+id/tvWidgetHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_header"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

    <!-- MIDDLE SECTION 1: STATS & PROGRESS BAR -->
    <LinearLayout
        android:id="@+id/llWidgetStatsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_stat_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_target" />

            <TextView
                android:id="@+id/tvWidgetStatGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Hoy: 8/10" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbWidgetGoalProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="50dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="6dp"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/progress_widget_horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fire" />

            <TextView
                android:id="@+id/tvWidgetStatRetention"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Retención: 85%" />
        </LinearLayout>
    </LinearLayout>

    <!-- MIDDLE SECTION 2: VERB OF THE DAY CARD -->
    <LinearLayout
        android:id="@+id/cardWidgetVerb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_verb_box"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWidgetVerbTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/verbo_del_dia_label"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetVerbLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_stat_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="B2 · IRREGULAR" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWidgetVerbBase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="FREEZE" />

            <TextView
                android:id="@+id/tvWidgetMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                tools:text="• Congelar, helar" />
        </LinearLayout>

        <!-- Conjugation Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWidgetV1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_stat_pill"
                android:gravity="center"
                android:paddingVertical="3dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="V1: freeze" />

            <TextView
                android:id="@+id/tvWidgetV2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_stat_pill"
                android:gravity="center"
                android:paddingVertical="3dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="V2: froze" />

            <TextView
                android:id="@+id/tvWidgetV3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_stat_pill"
                android:gravity="center"
                android:paddingVertical="3dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="V3: frozen" />
        </LinearLayout>
    </LinearLayout>

    <!-- FOOTER ACTION BAR: Quick Practice Button -->
    <LinearLayout
        android:id="@+id/btnWidgetPractice"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_btn_practice"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_sports_billiards" />

        <TextView
            android:id="@+id/tvWidgetActionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_action_practice"
            android:textColor="@color/widget_accent_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

</LinearLayout>
