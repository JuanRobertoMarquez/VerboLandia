<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/layoutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutSolvedBadge"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crossword_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_label_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCrosswordSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_sm"
                tools:text="Nivel B1 • 4 Palabras" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSolvedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focus_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvSolvedCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold"
                tools:text="0/4" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Clue Card (Context, Sentence, Phonetics, Audio) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardClue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="@dimen/rounded_md"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_sm">

            <!-- Direction & Number Badge -->
            <TextView
                android:id="@+id/tvDirectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tense_tag_dark"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="2dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1 HORIZONTAL" />

            <!-- Speaker Button -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/crossword_btn_audio"
                android:padding="4dp"
                android:src="@drawable/ic_volume"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorPrimary" />

            <!-- Clue Tense / Request -->
            <TextView
                android:id="@+id/tvClueTense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_label_md"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvDirectionBadge"
                app:layout_constraintEnd_toStartOf="@id/btnSpeaker"
                app:layout_constraintStart_toEndOf="@id/tvDirectionBadge"
                app:layout_constraintTop_toTopOf="@id/tvDirectionBadge"
                tools:text="Participio Pasado (V3) de CHOOSE" />

            <!-- Context Sentence with Blank -->
            <TextView
                android:id="@+id/tvClueSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_practice_quote_card"
                android:padding="@dimen/spacing_sm"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvDirectionBadge"
                tools:text="They have _______ the best option." />

            <!-- Bottom Clue Pills: Meaning & Phonetics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvClueSentence">

                <TextView
                    android:id="@+id/tvClueMeaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_focus_pill"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="Elegir / Escoger" />

                <TextView
                    android:id="@+id/tvCluePhonetics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_practice_quote_card"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label_sm"
                    tools:text="/u:/ - /oʊ/" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Word Navigation Chips -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/margin"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/cardClue">

        <LinearLayout
            android:id="@+id/layoutWordChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Crossword Grid View (Fills middle available space) -->
    <com.example.verbolandia.crossword.CrosswordGridView
        android:id="@+id/crosswordGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/includeKeyboard"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollChips" />

    <!-- Custom On-screen QWERTY Keyboard -->
    <include
        android:id="@+id/includeKeyboard"
        layout="@layout/layout_crossword_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
