<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/layoutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutCounterBadge"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wordsearch_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_label_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTargetTenseSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_sm"
                tools:text="Tiempo Objetivo: Pasado Simple (V2)" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCounterBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focus_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvFoundCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold"
                tools:text="0/4" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Live Tracing Status Bar -->
    <TextView
        android:id="@+id/tvLiveTracing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_practice_quote_card"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:text="@string/wordsearch_tracing_idle"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_label_md"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Word Search Canvas View (8x8 Grid) -->
    <com.example.verbolandia.wordsearch.WordSearchCanvasView
        android:id="@+id/wordSearchGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/scrollTargetChips"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLiveTracing" />

    <!-- Target Words Horizontal Chips -->
    <HorizontalScrollView
        android:id="@+id/scrollTargetChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/margin"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutActionButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutTargetChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Support Actions Row -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toTopOf="@id/cardGrammarPill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSoundHint"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/wordsearch_btn_sound_hint"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_pill_radius"
            app:icon="@drawable/ic_volume"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoneticHint"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/wordsearch_btn_phonetic_hint"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_pill_radius"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestart"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/wordsearch_btn_restart"
            android:textSize="@dimen/text_label_sm"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_pill_radius"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- Bottom Grammatical Pill Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGrammarPill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="@dimen/rounded_md"
        app:cardElevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvPillTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/wordsearch_pill_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPillTense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tense_tag_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold"
                    tools:text="V2 PASADO" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPillVerb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_label_md"
                android:textStyle="bold"
                tools:text="CATCH - CAUGHT · Atrapar (/kɔːt/)" />

            <TextView
                android:id="@+id/tvPillExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_body_sm"
                tools:text="Regla: Forma irregular con terminación -aught. Las letras 'gh' son mudas y la vocal suena /ɔː/." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
