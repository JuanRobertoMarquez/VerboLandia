<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09301B"
    android:fitsSystemWindows="true">

    <!-- Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#062213"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="🎱 Billar de Verbos"
            android:textColor="@color/white"
            android:textSize="@dimen/text_headline_sm"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_small"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="4dp"
            android:text="Aciertos: 0 | 🔥 0"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_label_md"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pool Table Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBilliardsTable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginVertical="@dimen/spacing_lg"
        app:cardBackgroundColor="#0D5C32"
        app:cardCornerRadius="@dimen/rounded_2xl"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:strokeColor="#5C3A21"
        app:strokeWidth="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Pocket 1: Top-Left -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketTopLeft"
                android:layout_width="120dp"
                android:layout_height="90dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#374151"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕳️ Tronera 1"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPocketTopLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold"
                        tools:text="froze" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 2: Top-Right -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketTopRight"
                android:layout_width="120dp"
                android:layout_height="90dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#374151"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕳️ Tronera 2"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPocketTopRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold"
                        tools:text="freezed" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 3: Bottom-Left -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketBottomLeft"
                android:layout_width="120dp"
                android:layout_height="90dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:strokeColor="#374151"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕳️ Tronera 3"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPocketBottomLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold"
                        tools:text="frozen" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 4: Bottom-Right -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketBottomRight"
                android:layout_width="120dp"
                android:layout_height="90dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:strokeColor="#374151"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕳️ Tronera 4"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPocketBottomRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_headline_sm"
                        android:textStyle="bold"
                        tools:text="freezing" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Center Target Cue Ball -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTargetBall"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="90dp"
                app:cardElevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#38BDF8"
                app:strokeWidth="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎱 TIRA A LA TRONERA"
                        android:textColor="#0284C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTargetVerbBase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="FREEZE" />

                    <TextView
                        android:id="@+id/tvTargetVerbPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="¿Cuál es el Pasado Simple?"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls & Next Verb Button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#062213"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvBilliardsFeedback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Elige la tronera correcta con el pasado del verbo."
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextVerb"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="Siguiente ➔"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_label_md"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="@dimen/rounded_lg" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
