<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/billiard_green_dark"
    android:fitsSystemWindows="true">

    <!-- Tablero de Billar que Ocupa Toda la Pantalla -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBilliardsTable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        app:cardBackgroundColor="@color/billiard_green_felt"
        app:cardCornerRadius="@dimen/rounded_2xl"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/billiard_cushion_border"
        app:strokeWidth="@dimen/billiard_cushion_stroke">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Physics Interactive Pool Table View -->
            <com.example.verbolandia.view.PoolTableView
                android:id="@+id/poolTableView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- POCKET OPTIONS (Cards sin etiquetas innecesarias, sólo la respuesta) -->

            <!-- Pocket 1: Top-Left Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketTopLeft"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="64dp"
                app:cardBackgroundColor="@color/billiard_card_bg"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/billiard_card_stroke"
                app:strokeWidth="@dimen/billiard_pocket_stroke">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvPocketTopLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="froze" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 2: Top-Right Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketTopRight"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginTop="64dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/billiard_card_bg"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/billiard_card_stroke"
                app:strokeWidth="@dimen/billiard_pocket_stroke">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvPocketTopRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="freezed" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 5: Middle-Left Card (Unlocked at Level 6) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketMidLeft"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/billiard_card_bg"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/billiard_card_stroke"
                app:strokeWidth="@dimen/billiard_pocket_stroke"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvPocketMidLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="freezing" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 6: Middle-Right Card (Unlocked at Level 6) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketMidRight"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/billiard_card_bg"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/billiard_card_stroke"
                app:strokeWidth="@dimen/billiard_pocket_stroke"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvPocketMidRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="freezes" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 3: Bottom-Left Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketBottomLeft"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/billiard_card_bg"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:strokeColor="@color/billiard_card_stroke"
                app:strokeWidth="@dimen/billiard_pocket_stroke">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvPocketBottomLeftText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="frozen" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pocket 4: Bottom-Right Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPocketBottomRight"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/billiard_card_bg"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:strokeColor="@color/billiard_card_stroke"
                app:strokeWidth="@dimen/billiard_pocket_stroke">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvPocketBottomRightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="freezing" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Centered Floating Verb Info Banner (Indicador del Verbo Objetivo) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTargetBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                app:cardBackgroundColor="@color/billiard_hud_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/secondary_accent"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvTargetVerbBase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="FREEZE" />

                    <TextView
                        android:id="@+id/tvTargetVerbPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/billiard_text_dim"
                        android:textSize="11sp"
                        tools:text="Significado: Congelar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Centered Animated Feedback Overlay (Ventana/Tarjeta de Resultado sin Emojis) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedbackOverlay"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/billiard_hud_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/secondary_accent"
                app:strokeWidth="2.5dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/ivFeedbackIcon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:id="@+id/tvFeedbackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/billiards_feedback_correct"
                        android:textColor="@color/success"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFeedbackBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="freeze -> froze" />

                    <TextView
                        android:id="@+id/tvFeedbackAutoNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/billiards_next_question_auto"
                        android:textColor="@color/billiard_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FLOATING TOP BAR (Overlay Flotante Superior) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/billiard_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/billiard_card_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvQuestionBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="¿Cuál es el Past Simple de FREEZE?" />

            <TextView
                android:id="@+id/tvScoreBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_badge_small"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="0 pts" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
