<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin"
    android:layout_marginVertical="@dimen/spacing_sm"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="@dimen/rounded_2xl"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header skeleton -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="90dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_badge_small"
                android:backgroundTint="?attr/colorSurfaceContainerHigh" />

            <View
                android:layout_width="40dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_badge_small"
                android:backgroundTint="?attr/colorSurfaceContainer" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:layout_width="32dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_small"
                android:backgroundTint="?attr/colorSurfaceContainer" />

            <View
                android:layout_width="54dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_badge_small"
                android:backgroundTint="?attr/colorSurfaceContainer" />
        </LinearLayout>

        <!-- Meaning skeleton -->
        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_badge_small"
            android:backgroundTint="?attr/colorSurfaceContainer" />

        <!-- Matrix skeleton -->
        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_badge_small"
            android:backgroundTint="?attr/colorSurfaceContainerLow" />

        <!-- Progress bar skeleton -->
        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_badge_small"
            android:backgroundTint="?attr/colorSurfaceContainer" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
