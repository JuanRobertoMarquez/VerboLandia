<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Scrollable Central Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Top Header: Logo, App Title & User Avatar -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_dictionary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_headline_sm"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivLogo"
                app:layout_constraintTop_toTopOf="@id/ivLogo" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_label_sm"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/tvHeaderTitle"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginEnd="@dimen/margin"
                android:contentDescription="@string/cd_avatar"
                android:src="@drawable/ic_avatar_placeholder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Title & Active Badge -->
            <TextView
                android:id="@+id/tvExplorerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:text="@string/explorer_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_headline_lg"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/badgeActiveVerbs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivLogo" />

            <!-- Interactive Active Verbs Badge -->
            <LinearLayout
                android:id="@+id/badgeActiveVerbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin"
                android:background="@drawable/bg_badge_small"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs"
                app:layout_constraintBottom_toBottomOf="@id/tvExplorerTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvExplorerTitle">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flash"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/active_verbs_badge"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_label_md"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExplorerSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/margin"
                android:text="@string/explorer_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_body_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExplorerTitle" />

            <!-- Search Bar Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_bar_height"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/rounded_xl"
                app:cardElevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExplorerSubtitle"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:autofillHints="none"
                        android:background="@null"
                        android:hint="@string/dict_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Horizontal Category Filters -->
            <HorizontalScrollView
                android:id="@+id/scrollFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/margin"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSearch">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_pill_filter"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="@string/filter_all_count"
                        android:textColor="?attr/colorSurface"
                        android:textSize="@dimen/text_label_md"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFilterIrregular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_pill_filter"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="@string/filter_irregular_count"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_md" />

                    <TextView
                        android:id="@+id/btnFilterRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_filter"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="@string/filter_regular_count"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_label_md" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Featured "VERBO DEL DÍA" Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerbOfDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/rounded_2xl"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollFilters"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:id="@+id/ivPin"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin"
                        app:layout_constraintBottom_toBottomOf="@id/tvVerbOfDayLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvVerbOfDayLabel"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvVerbOfDayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/verbo_del_dia_label"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/ivPin"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/btnVerbOfDayAudio"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_small"
                        android:contentDescription="@string/cd_play_audio"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_volume"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvVerbOfDayTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/verbo_del_dia_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_headline_md"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/btnVerbOfDayAudio"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvVerbOfDayLabel" />

                    <!-- Micro-columns conjugation badges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvVerbOfDayTitle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:background="@drawable/bg_badge_small"
                            android:paddingHorizontal="@dimen/spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="@string/verbo_del_dia_v1"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_label_sm" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:background="@drawable/bg_badge_small"
                            android:paddingHorizontal="@dimen/spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="@string/verbo_del_dia_v2"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_label_sm" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_small"
                            android:paddingHorizontal="@dimen/spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="@string/verbo_del_dia_v3"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_label_sm" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header -->
            <TextView
                android:id="@+id/tvSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/list_header_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_md"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardVerbOfDay" />

            <TextView
                android:id="@+id/tvSectionResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin"
                android:text="@string/list_header_results"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label_md"
                app:layout_constraintBaseline_toBaselineOf="@id/tvSectionHeader"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Syntactic Verbs List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVerbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionHeader"
                tools:itemCount="5"
                tools:listitem="@layout/item_verb_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:backgroundTint="?attr/colorSurfaceContainer"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
