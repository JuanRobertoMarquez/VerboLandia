        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>

        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>

        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>

        <!-- Typography Mapping for Plus Jakarta Sans -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Verbolandia.DisplayLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Verbolandia.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Verbolandia.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Verbolandia.HeadlineSmall</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.Verbolandia.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Verbolandia.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Verbolandia.BodySmall</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.Verbolandia.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Verbolandia.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Verbolandia.LabelSmall</item>
    </style>

    <style name="Theme.Verbolandia" parent="Base.Theme.Verbolandia" />

    <!-- Plus Jakarta Sans Typography Styles -->

    <style name="TextAppearance.Verbolandia.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">44sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.Verbolandia.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif</item>
